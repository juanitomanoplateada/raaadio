# https://editorconfig.org — mismo formato en cualquier editor
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{cpp,h}]
trim_trailing_whitespace = true

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_size = 4
